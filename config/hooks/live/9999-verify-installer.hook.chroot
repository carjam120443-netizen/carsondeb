#!/bin/sh
set -eu

# Fail the image build if the CarsonDEB installer payload is incomplete.
# Keep this hook limited to filesystem/package checks: Calamares is a GUI
# application and should not be launched from the build chroot.

printf '%s\n' 'Checking Calamares installer payload...'
command -v calamares >/dev/null 2>&1
[ -x /usr/bin/calamares ]
[ -f /etc/calamares/settings.conf ]
[ -f /etc/calamares/branding/carsondeb/branding.desc ]
[ -f /usr/share/applications/carsondeb-installer.desktop ]
[ -f /usr/share/icons/hicolor/scalable/apps/carsondeb.svg ]

# Validate the desktop launcher points at the installed Calamares binary.
grep -qx 'Exec=pkexec calamares' /usr/share/applications/carsondeb-installer.desktop

grep -qx 'branding: carsondeb' /etc/calamares/settings.conf

grep -qx 'componentName: carsondeb' /etc/calamares/branding/carsondeb/branding.desc

grep -qx 'productName: CarsonDEB' /etc/calamares/branding/carsondeb/branding.desc

grep -qx 'productLogo: carsondeb.svg' /etc/calamares/branding/carsondeb/branding.desc

grep -qx 'productIcon: carsondeb.svg' /etc/calamares/branding/carsondeb/branding.desc

printf '%s\n' 'CarsonDEB installer payload checks passed.'
